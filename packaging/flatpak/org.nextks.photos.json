{
  "app-id": "org.nextks.photos",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "nkphotos",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc", "--socket=wayland", "--socket=fallback-x11", "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.nextkde.nkshot",
    "--env=QT_QPA_PLATFORMTHEME=xdgdesktopportal"
  ],
  "cleanup": ["/include", "/lib/cmake", "/lib/pkgconfig", "/lib/*.a"],
  "modules": [{
    "name": "nkphotos",
    "buildsystem": "cmake-ninja",
    "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DNKPHOTOS_BUILD_TESTS=OFF"],
    "sources": [{"type": "dir", "path": "../..", "skip": [".git", "tmp", "build", ".flatpak-builder"]}]
  }]
}
